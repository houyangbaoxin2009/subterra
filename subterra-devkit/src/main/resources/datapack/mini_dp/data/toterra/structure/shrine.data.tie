// toterra structure "shrine" — minimal structure_set schema: a DesertPyramid
// body bound to minecraft:plains, spaced by RandomSpreadStructurePlacement. The
// MC-shell registrar registers both the STRUCTURE and the STRUCTURE_SET entries
// (the E2E gate asserts registry visibility).
type tie<data>
structure = [
  type = "minecraft:structure_set",
  biomes = [ "minecraft:plains" ],
  spacing = 32,
  separation = 8,
  salt = 12345,
]
